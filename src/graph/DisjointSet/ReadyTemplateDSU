class DSU{
    int[] par,rank;
    public DSU(int V){
        par=new int[V];
        rank=new int[V];
        for(int i=0;i<V;i++){
            par[i]=i;
        }
    }

    public int find(int x){
        if(par[x]==x) return par[x];
        par[x]=find(par[x]);
        return par[x];
    }

    public void union(int x,int y){
        int x_rep=find(x);
        int y_rep=find(y);

        if(x_rep==y_rep) return ;

        if(rank[x_rep]<rank[y_rep]){
            par[x_rep]=y_rep;
        }else if(rank[y_rep]<rank[x_rep]){
            par[y_rep]=x_rep;
        }else{
            par[x_rep]=y_rep;
            rank[x_rep]++;
        }
    }
}
